# Copy to server/.env for local, or set these in Railway Variables

# Public URL of this app (Railway auto-sets RAILWAY_PUBLIC_DOMAIN; override if needed)
# Example: https://round-hunter-production.up.railway.app
PUBLIC_URL=

# Start hunting automatically on boot (default: true). Set false to require manual Start Swarm.
AUTO_START_SWARM=true

# Default hunt niche (Dental Clinics). Change industry/country in the UI anytime.
DEFAULT_TARGET_QUERY=Dental Clinic in New York, USA

# UK hunt — accurate Cylex directory via Apify (https://www.cylex-uk.co.uk/)
# Get token: Apify Console → Settings → Integrations → API token
# Actor: vulnv/cylex-uk-scraper (~$3.50 / 1k results). UI: Overview → UK data source.
APIFY_API_TOKEN=
# UK_HUNT_SOURCE=auto          # auto | cylex_api | ddg  (also toggled in UI)
# CYLEX_MAX_RESULTS=12
# CYLEX_MAX_PAGES=2

# Optional: Cursor dev only — Apify MCP (manual tests in IDE, not used on Railway):
# "mcpServers": { "apify": { "type": "http", "url": "https://mcp.apify.com/?tools=vulnv/cylex-uk-scraper" } }

# Brevo SMTP (required for sending cold emails)
BREVO_SMTP_USER=your-login@smtp-brevo.com
BREVO_SMTP_PASS=your-smtp-key
# Recommended on Railway (HTTPS works when SMTP ports time out):
# Brevo → Settings → SMTP & API → API keys → create key
BREVO_API_KEY=

# IMAP inbox monitor (optional — reply parsing)
IMAP_SERVER=imap.mail.ap-southeast-1.awsapps.com
IMAP_USER=
IMAP_PASS=
